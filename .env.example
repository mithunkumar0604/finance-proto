# Copy to .env.local for local development. Never commit real values.
# With these two empty, the app runs on built-in demo data (no database, no login).

# Supabase project URL and its PUBLISHABLE key (sb_publishable_...). Both are meant for
# the browser: what a user can see or change is enforced by the database, not by hiding
# this key. (The older NEXT_PUBLIC_SUPABASE_ANON_KEY is still read if set.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The business name shown in the app and on receipts.
NEXT_PUBLIC_BUSINESS_NAME=

# Optional. People sign in with a mobile number, stored as <number>@<this domain>.
# Leave empty (default "ledgerpro.invalid", which can never receive mail).
# Only set a real domain if the business owns it.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=

# Optional. Only for hosting under a sub-path (the GitHub Pages demo uses /finance-proto).
NEXT_PUBLIC_BASE_PATH=

# NEVER put these in a NEXT_PUBLIC_ variable or in this repository. They belong only in
# GitHub Actions secrets (see ENVIRONMENT.md):
#   SUPABASE_DB_URL, BACKUP_PASSPHRASE, BACKUP_REPO_TOKEN, CLOUDFLARE_API_TOKEN,
#   CLOUDFLARE_ACCOUNT_ID, and the Supabase SECRET key (sb_secret_..., formerly "service role").
